{
  "expo": {
    "name": "OopsScam",
    "slug": "oopsscam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/oopsscam-icon-square.png",
    "scheme": "oopsscam",
    "userInterfaceStyle": "light",
    "platforms": ["android"],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/oopsscam-icon-square.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.oopsscam.app",
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/oopsscam-logo-LIGHT NO BG.png",
          "imageWidth": 180
        }
      ],
      "llama.rn",
      "./plugins/with-bundled-model.cjs",
      [
        "expo-camera",
        {
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ],
          "disableIOS": true
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
